<mxfile host="app.diagrams.net"><diagram name="GCP architecture" id="gcp-arch"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="URL Shortener on Google Cloud (GKE)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Developer machine / VM&lt;/b&gt;&lt;br&gt;build.sh, deploy-gke.sh&lt;br&gt;docker or podman, kubectl" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="132" width="220" height="80" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;User browser&lt;/b&gt;&lt;br&gt;https://u.example.com" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="220" height="60" as="geometry"/></mxCell><mxCell id="cf" value="&lt;b&gt;Cloudflare DNS + proxy&lt;/b&gt;&lt;br&gt;optional; TLS mode Flexible&lt;br&gt;(or Google managed cert)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="373" width="220" height="80" as="geometry"/></mxCell><mxCell id="gcp" value="Google Cloud project · region australia-southeast1" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f8f9fa;strokeColor=#4285f4;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="1100" height="880" as="geometry"/></mxCell><mxCell id="ar" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;repo urlshortener&lt;br&gt;4 images" style="sketch=0;html=1;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="gcp"><mxGeometry x="60" y="80" width="50" height="45" as="geometry"/></mxCell><mxCell id=