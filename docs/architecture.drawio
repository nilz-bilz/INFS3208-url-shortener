<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="URL Shortener on Kubernetes (GKE / kind)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="0" width="600" height="40" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;User browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;s.yourdomain.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="cluster" value="GKE cluster (3 nodes) · namespace urlshortener" style="swimlane;startSize=30;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="920" height="460" as="geometry"/></mxCell><mxCell id="ingress" value="&lt;b&gt;Ingress&lt;/b&gt; → GCP HTTP(S) Load Balancer · static IP + managed cert (ingress-nginx on kind)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="cluster"><mxGeometry x="20" y="45" width="880" height="50" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;nginx · static UI · ×2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster"><mxGeometry x="20" y="160" width="160" height="70" as="geometry"/></mxCell><mxCell id="sh" value="&lt;b&gt;shortener&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Flask · auth + links · ×2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster"><mxGeometry x="200" y="160" width="160" height="70" as="geometry"/></mxCell>