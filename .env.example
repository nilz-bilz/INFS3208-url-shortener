# Copy to .env (cp .env.example .env). Dev defaults only; never commit real secrets.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=shortener
DB_USER=app
DB_PASSWORD=devpassword
MYSQL_ROOT_PASSWORD=devroot
REDIS_HOST=redis
REDIS_PORT=6379
BASE_URL=http://localhost:8080
SESSION_TTL_SECONDS=86400
CACHE_TTL_SECONDS=3600
# Build-time only (baked into images as a build arg); equals the image tag
APP_VERSION=v1
